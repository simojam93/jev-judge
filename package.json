{
  "name": "jev-judge",
  "version": "0.2.0",
  "description": "Calibrated relevance and spam judgments for social posts, powered by Jev (TypeSafe System One)",
  "type": "module",
  "license": "MIT",
  "private": false,
  "author": "Simone Lovera",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "prepare": "npm run build",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simojam93/jev-judge.git"
  },
  "keywords": [],
  "bugs": {
    "url": "https://github.com/simojam93/jev-judge/issues"
  },
  "homepage": "https://github.com/simojam93/jev-judge#readme",
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
